#!/usr/bin/env ruby

# Writes the visual snapshots PR comment to visual-snapshots.tmp. Images are
# referenced by their local paths; `gh pr comment --attach` uploads them and
# rewrites the references to the uploaded URLs.

def array_to_markdown_table(array_of_arrays)
  return "" if array_of_arrays.nil? || array_of_arrays.empty?

  headers = array_of_arrays.first
  rows = array_of_arrays[1..] || []

  # Create the header row
  header_line = "| " + headers.map(&:to_s).join(" | ") + " |"
  # Create the separator row
  separator = "| " + headers.map { "---" }.join(" | ") + " |"
  # Create each data row
  row_lines = rows.map { |row| "| " + row.map(&:to_s).join(" | ") + " |" }

  ([header_line, separator] + row_lines).join("\n")
end

HELP_MESSAGE = <<~EOS
Usage: ./bin/snapshots-comment SNAPSHOTS_DIR
EOS

if ARGV.length != 1
  puts HELP_MESSAGE
  exit 1
end

dir = ARGV[0]

def image_cell(dir, page_size, version, label)
  path = File.join(dir, "#{page_size}-#{version}.png")
  if File.exist?(path)
    "![#{label}](#{path})"
  elsif version == "diff"
    "No differences"
  else
    "Missing"
  end
end

table = [
  # Headers
  ["", "Latest release", "Current commit", "Diff"],
  # Rows
  ["A4",
   image_cell(dir, "a4", "release", "A4 release"),
   image_cell(dir, "a4", "current", "A4 current"),
   image_cell(dir, "a4", "diff", "A4 diff")],
  ["Letter",
   image_cell(dir, "letter", "release", "Letter release"),
   image_cell(dir, "letter", "current", "Letter current"),
   image_cell(dir, "letter", "diff", "Letter diff")]
]

comment = <<~TABLE
## PaperAge visual snapshots

Compare the output of the latest release version of PaperAge with the results from the current commit.

#{array_to_markdown_table(table)}

Encryption passphrase: `#{ENV['PAPERAGE_PASSPHRASE']}`

TABLE

File.open('visual-snapshots.tmp', 'w') { _1.write(comment) }

puts "Wrote visual-snapshots.tmp"
